{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Discovery Observation",
  "type": "object",
  "required": [
    "intent_id",
    "evidence_tier",
    "event_type"
  ],
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_tier": {
      "enum": [
        "field",
        "controlled_lab",
        "exploratory",
        "human",
        "outcome"
      ]
    },
    "event_type": {
      "enum": [
        "search_query",
        "search_results",
        "result_open",
        "citation",
        "final_choice",
        "pairwise_choice",
        "rationale",
        "candidate_suggestion",
        "human_choice",
        "registrar_click",
        "registration_transition",
        "deployment",
        "tool_invocation",
        "task_success"
      ]
    },
    "model_family": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
